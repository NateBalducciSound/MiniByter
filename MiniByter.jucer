<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="mByter1" name="MiniByter" projectType="audioplug" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" bundleIdentifier="com.hsdx.minibyter"
              companyWebsite="www.hsdx.am" companyName="HSDX">
  <MAINGROUP id="mByter2" name="MiniByter">
    <GROUP id="{A1B2C3D4-E5F6-0001-1234-ABCDEF012345}" name="Source">
      <FILE id="mByter3" name="PluginProcessor.cpp" compile="1" resource="0"
            file="Source/PluginProcessor.cpp"/>
      <FILE id="mByter4" name="PluginProcessor.h" compile="0" resource="0"
            file="Source/PluginProcessor.h"/>
      <FILE id="mByter5" name="PluginEditor.cpp" compile="1" resource="0"
            file="Source/PluginEditor.cpp"/>
      <FILE id="mByter6" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
